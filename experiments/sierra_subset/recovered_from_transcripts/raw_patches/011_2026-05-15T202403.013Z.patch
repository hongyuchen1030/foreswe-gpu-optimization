+
+REPO_ROOT = Path("/global/homes/h/hyvchen/Snow-Predication-at-Sierra")
+THIRDPARTY_ROOT = REPO_ROOT / "thirdparties" / "SWE-Forecasting"
+SIERRA_HOME_ROOT = Path(
