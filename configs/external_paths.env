# External (not-in-git) ForeSWE artifacts. Sourced by fsw_env.sh; override any variable before sourcing.
# All historical locations are READ-ONLY inputs: never point a training run's output root at them.

# Historical trained attention checkpoints (model + AdamW state), verified 2026-10-26.
: "${FSW_CKPT_PLANB:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_planB_24week/checkpoints/planB_24week_att_model.pt}"
: "${FSW_CKPT_DAILY:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra/thirdparties/SWE-Forecasting/checkpoints/forecasting_modified_daily_att_climax_model_gp_act.pt}"
: "${FSW_CKPT_DAILY_PRE_SCRATCH:=/global/homes/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_reproduction/archive_pre_scratch_attention_20260506_144156/checkpoints/forecasting_modified_daily_att_climax_model_gp_act.pt}"
: "${FSW_CKPT_WEEKLY:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_weekly_reproduction_full512/checkpoints/forecasting_modified_weekly_att_climax_model_gp_act.pt}"
: "${FSW_CKPT_SIERRA43:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_sierra_station/checkpoints/forecasting_modified_daily_att_climax_model_gp_act.pt}"
: "${FSW_CKPT_D2:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_domain_sensitivity/D2_sierra_plus_500km/checkpoints/forecasting_modified_daily_att_climax_model_gp_act.pt}"

# Historical output stores (results pickles, GP inputs, logs).
: "${FSW_LEGACY_SCRATCH:=/pscratch/sd/h/hyvchen/Snow-Predication-at-Sierra}"
: "${FSW_LEGACY_HOME:=/global/homes/h/hyvchen/Snow-Predication-at-Sierra}"

# Sentence-transformer (all-MiniLM-L6-v2) cache used to build the 1536-d station prompts offline.
: "${FSW_HF_CACHE:=/pscratch/sd/h/hyvchen/foreswe_model_cache}"

# D2 domain-sensitivity data subset (326 MB, derived from data/ by the D2 scripts).
: "${FSW_D2_DATA_SUBSET:=/global/homes/h/hyvchen/Snow-Predication-at-Sierra/experiments/foreswe_domain_sensitivity/D2_sierra_plus_500km/data_subset}"

export FSW_CKPT_PLANB FSW_CKPT_DAILY FSW_CKPT_DAILY_PRE_SCRATCH FSW_CKPT_WEEKLY FSW_CKPT_SIERRA43 FSW_CKPT_D2 \
       FSW_LEGACY_SCRATCH FSW_LEGACY_HOME FSW_HF_CACHE FSW_D2_DATA_SUBSET
